<Window
    x:Class="LiveCaptionsTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LiveCaptions Translator"
    Width="1000"
    Height="600"
    MinWidth="720"
    MinHeight="400"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" Background="#11000000">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Content="LiveCaptions"
                        Click="LiveCaptionsButton_Click"
                        Style="{StaticResource ToolButton}"
                        ToolTip="Open/show the Windows Live Captions window" />
                    <Button
                        x:Name="PauseButton"
                        Content="⏸ Pause"
                        Click="PauseButton_Click"
                        Style="{StaticResource ToolButton}" />
                    <Button
                        x:Name="TopmostButton"
                        Content="📌"
                        Click="TopmostButton_Click"
                        Style="{StaticResource ToolButton}"
                        ToolTip="Always on top" />
                    <Button
                        Content="Clear"
                        Click="ClearButton_Click"
                        Style="{StaticResource ToolButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#666666" />
                    <TextBlock x:Name="LlmStatusText" Margin="16,0,0,0" Foreground="#666666" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#888888" Text="ORIGINAL" />
                <TextBlock Grid.Column="1" FontSize="12" Foreground="#888888" Text="TRANSLATION" />
            </Grid>

            <Border Grid.Row="1" Background="#08000000">
                <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LinesItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource LineTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFinal}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Text>
                                            <Binding Path="Original" />
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <Grid Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock
                                            Style="{StaticResource LineTextStyle}"
                                            Text="{Binding Translation}"
                                            Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Style="{StaticResource LineTextStyle}"
                                            Text="{Binding Error}"
                                            Foreground="IndianRed"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Text="…"
                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LineTextStyle}">
                                                    <Setter Property="Foreground" Value="#CCCCCC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                                            <Setter Property="Foreground" Value="#777777" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
